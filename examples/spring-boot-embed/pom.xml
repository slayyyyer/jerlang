<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>example</groupId>
  <artifactId>spring-boot-embed</artifactId>
  <version>1.0.0</version>
  <name>JErlang Spring Boot embedding example</name>
  <description>Compile Erlang with JErlang and serve it from a Spring Boot service, with no Erlang installation.</description>

  <properties>
    <java.version>21</java.version>
    <jerlang.version>3.0.0</jerlang.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.slayyyyer</groupId>
      <artifactId>jerlang</artifactId>
      <version>${jerlang.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>compile-erlang</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>java</executable>
              <arguments>
                <argument>-classpath</argument>
                <classpath/>
                <argument>org.jerlang.compiler.CompilerCommand</argument>
                <argument>-o</argument>
                <argument>${project.build.directory}/ebin</argument>
                <argument>${project.basedir}/src/main/erl/greeter.erl</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
