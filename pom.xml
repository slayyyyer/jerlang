<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <!--
    Coordinates are io.github.slayyyyer because Maven Central only lets you
    publish into a namespace you can prove you control: org.jerlang would need a
    DNS record on jerlang.org or the jerlang GitHub organisation, and this fork
    controls neither. io.github.<username> is verified against the GitHub account
    itself, so it is the honest choice for a fork.

    The Java packages stay org.jerlang.*: a group id is a coordinate, not a
    package prefix, and renaming the packages would break every embedder to
    gain nothing.
  -->
  <groupId>io.github.slayyyyer</groupId>
  <artifactId>jerlang</artifactId>
  <name>JErlang</name>
  <version>1.0.1</version>
  <description>An Erlang runtime and interpreter on the JVM: BEAM modules, the
    external term format and OTP's standard library, embedded in a Java process
    or run as a node.</description>
  <url>https://github.com/slayyyyer/jerlang</url>
  <prerequisites>
    <maven>3.0</maven>
  </prerequisites>
  <distributionManagement>
    <site>
      <url>https://slayyyyer.github.io/jerlang/</url>
    </site>
    <!-- Central Portal. The id has to match the server id in settings.xml,
         and publishing is opt-in through the central profile so a normal
         build never talks to a repository. -->
    <repository>
      <id>central</id>
      <url>https://central.sonatype.com/api/v1/publisher</url>
    </repository>
    <snapshotRepository>
      <id>central</id>
      <url>https://central.sonatype.com/api/v1/publisher</url>
    </snapshotRepository>
  </distributionManagement>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Reproducible build: a fixed timestamp instead of the wall clock, so
         the same source builds to the same bytes. scripts/package.sh checks
         it by building twice and comparing checksums. -->
    <project.build.outputTimestamp>2026-11-01T00:00:00Z</project.build.outputTimestamp>
    <version.assertj>3.8.0</version.assertj>
    <version.jacoco-maven-plugin>0.8.16</version.jacoco-maven-plugin>
    <version.japicmp-maven-plugin>0.26.5</version.japicmp-maven-plugin>
    <version.commons-math3>3.6.1</version.commons-math3>
    <version.coveralls-maven-plugin>4.3.0</version.coveralls-maven-plugin>
    <version.findbugs-maven-plugin>3.0.1</version.findbugs-maven-plugin>
    <version.jline>2.14.5</version.jline>
    <version.junit>4.13.1</version.junit>
    <version.jnr-posix>3.1.20</version.jnr-posix>
    <version.jzlib>1.1.3</version.jzlib>
    <version.maven-checkstyle-plugin>2.6</version.maven-checkstyle-plugin>
    <version.maven-compiler-plugin>3.7.0</version.maven-compiler-plugin>
    <version.maven-javadoc-plugin>3.12.0</version.maven-javadoc-plugin>
    <version.maven-jxr-plugin>2.5</version.maven-jxr-plugin>
    <version.maven-pmd-plugin>3.8</version.maven-pmd-plugin>
    <version.maven-project-info-reports-plugin>2.9</version.maven-project-info-reports-plugin>
    <!-- 3.2.4 and later honour project.build.outputTimestamp, so the shaded
         jar is byte-identical across builds; 3.1.0 stamped the wall clock into
         every entry, which is what made the reproducibility check fail. -->
    <version.maven-shade-plugin>3.6.0</version.maven-shade-plugin>
    <version.maven-site-plugin>3.22.0</version.maven-site-plugin>
    <version.maven-surefire-report-plugin>2.20.1</version.maven-surefire-report-plugin>
    <version.pitest-maven>1.30.1</version.pitest-maven>
    <version.maven-source-plugin>3.3.1</version.maven-source-plugin>
    <version.maven-gpg-plugin>3.2.7</version.maven-gpg-plugin>
    <version.central-publishing-maven-plugin>0.12.0</version.central-publishing-maven-plugin>
  </properties>
  <issueManagement>
    <url>https://github.com/slayyyyer/jerlang/issues</url>
  </issueManagement>
  <developers>
    <developer>
      <id>c-rack</id>
      <name>Constantin Rack</name>
      <url>http://co.nstant.in/</url>
      <timezone>+1</timezone>
      <roles>
        <role>Author</role>
      </roles>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/slayyyyer/jerlang.git</connection>
    <developerConnection>scm:git:https://github.com/slayyyyer/jerlang.git</developerConnection>
    <url>https://github.com/slayyyyer/jerlang</url>
    <tag>1.0.1</tag>
  </scm>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <version>${version.maven-pmd-plugin}</version>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>${version.maven-shade-plugin}</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <finalName>${project.build.finalName}</finalName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <keepDependenciesWithProvidedScope>true</keepDependenciesWithProvidedScope>
              <transformers>
                <transformer
                  implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer">
                  <addHeader>false</addHeader>
                </transformer>
                <transformer
                  implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>org.jerlang.erts.Emulator</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!--
          The API gate. src/api-baseline holds the 0.3.0 jar, so every public
          change since then is compared against a real artifact instead of a
          description of one. The baseline is refreshed only when the version
          is bumped.
        -->
        <groupId>com.github.siom79.japicmp</groupId>
        <artifactId>japicmp-maven-plugin</artifactId>
        <version>${version.japicmp-maven-plugin}</version>
        <configuration>
          <oldVersion>
            <file>
              <path>${project.basedir}/src/api-baseline/jerlang-0.3.0.jar</path>
            </file>
          </oldVersion>
          <newVersion>
            <!-- The unshaded artifact: the shaded jar carries the bundled
                 dependencies, whose API is not this project's to keep. -->
            <file>
              <path>${project.build.directory}/original-${project.build.finalName}.jar</path>
            </file>
          </newVersion>
          <parameter>
            <onlyModified>true</onlyModified>
            <accessModifier>public</accessModifier>
            <!-- Only the packages of this project are its API. The
                 shaded jar also carries jnr, jline and helper
                 packages, and maven-shade-plugin can leave the shaded
                 jar under the original- name on an incremental build,
                 so an unfiltered comparison audits a dependency API. -->
            <includes>
              <include>org.jerlang.*</include>
            </includes>
            <!-- jnr-posix reaches hawtjni at runtime; it is not on the
                 compile classpath japicmp builds, and no public API of this
                 project refers to it. -->
            <ignoreMissingClasses>true</ignoreMissingClasses>
            <breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
            <breakBuildOnSourceIncompatibleModifications>true</breakBuildOnSourceIncompatibleModifications>
            <breakBuildBasedOnSemanticVersioning>true</breakBuildBasedOnSemanticVersioning>
            <!-- 0.x: a minor bump may break the API, a patch bump may not. -->
            <breakBuildBasedOnSemanticVersioningForMajorVersionZero>true</breakBuildBasedOnSemanticVersioningForMajorVersionZero>
          </parameter>
        </configuration>
        <executions>
          <execution>
            <phase>verify</phase>
            <goals>
              <goal>cmp</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${version.maven-compiler-plugin}</version>
        <configuration>
          <release>${maven.compiler.release}</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-site-plugin</artifactId>
        <version>${version.maven-site-plugin}</version>
        <configuration>
          <locales>en</locales>
          <reportPlugins>
            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-javadoc-plugin</artifactId>
              <version>${version.maven-javadoc-plugin}</version>
            </plugin>
            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-jxr-plugin</artifactId>
              <version>${version.maven-jxr-plugin}</version>
              <configuration>
                <aggregate>true</aggregate>
              </configuration>
            </plugin>
            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-surefire-report-plugin</artifactId>
              <version>${version.maven-surefire-report-plugin}</version>
            </plugin>
            <plugin>
              <groupId>org.jacoco</groupId>
              <artifactId>jacoco-maven-plugin</artifactId>
              <version>${version.jacoco-maven-plugin}</version>
            </plugin>
            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-checkstyle-plugin</artifactId>
              <version>${version.maven-checkstyle-plugin}</version>
            </plugin>
            <plugin>
              <groupId>org.codehaus.mojo</groupId>
              <artifactId>findbugs-maven-plugin</artifactId>
              <version>${version.findbugs-maven-plugin}</version>
            </plugin>
            <plugin>
              <artifactId>maven-pmd-plugin</artifactId>
              <version>${version.maven-pmd-plugin}</version>
              <reportSets>
                <reportSet>
                  <reports>
                    <report>pmd</report>
                    <report>cpd</report>
                  </reports>
                </reportSet>
              </reportSets>
            </plugin>
          </reportPlugins>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <version>${version.pitest-maven}</version>
        <configuration>
          <targetClasses>
            <param>org.jerlang.*</param>
          </targetClasses>
          <targetTests>
            <param>org.jerlang.*</param>
          </targetTests>
          <mutators>
            <mutator>ALL</mutator>
          </mutators>
          <timestampedReports>false</timestampedReports>
          <exportLineCoverage>true</exportLineCoverage>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${version.jacoco-maven-plugin}</version>
      </plugin>
      <plugin>
        <groupId>org.eluder.coveralls</groupId>
        <artifactId>coveralls-maven-plugin</artifactId>
        <version>${version.coveralls-maven-plugin}</version>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <!--
      Publishing to Maven Central. Opt-in on purpose: a normal build has no
      reason to sign anything or talk to a repository, and the plugins below
      add a source jar, a javadoc jar and detached signatures to what Central
      requires of every artifact.

        mvn -B -Pcentral -DskipTests deploy            real publication
        mvn -B -Pcentral -DskipTests -Dgpg.skip=true package
                                                       check the bundle offline

      Credentials live in ~/.m2/settings.xml as a server id `central` holding a
      Portal token; the signing key is the one GPG already knows about. Neither
      belongs in this file. See docs/release.md.
    -->
    <profile>
      <id>central</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>${version.maven-source-plugin}</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <phase>package</phase>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>${version.maven-javadoc-plugin}</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <phase>package</phase>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <!-- The interpreter is documented in prose; doclint would fail
                   the bundle on a missing @param in a 4,000-file codebase. -->
              <doclint>none</doclint>
              <quiet>true</quiet>
              <failOnError>true</failOnError>
              <failOnWarnings>false</failOnWarnings>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>${version.maven-gpg-plugin}</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <gpgArguments>
                <arg>--pinentry-mode</arg>
                <arg>loopback</arg>
              </gpgArguments>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>${version.central-publishing-maven-plugin}</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!-- A deploy uploads the bundle and stops there. Publishing is
                   releasing, and a release is the thing the checklist in
                   docs/release.md has to clear first. -->
              <autoPublish>false</autoPublish>
              <waitUntil>uploaded</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
  <!--
    No <repositories> block: every dependency resolves from Central, and Maven
    Central refuses a pom that points at a plaintext http repository. The two
    that used to be here (java.net and repo.bodar.com) were long dead; removing
    them is what makes this pom publishable at all.
  -->
  <dependencies>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-math3</artifactId>
      <version>${version.commons-math3}</version>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${version.assertj}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.github.jnr</groupId>
      <artifactId>jnr-posix</artifactId>
      <version>${version.jnr-posix}</version>
    </dependency>
    <dependency>
      <groupId>jline</groupId>
      <artifactId>jline</artifactId>
      <version>${version.jline}</version>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>${version.junit}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.jcraft</groupId>
      <artifactId>jzlib</artifactId>
      <version>${version.jzlib}</version>
    </dependency>
  </dependencies>
  <reporting>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jxr-plugin</artifactId>
        <version>${version.maven-jxr-plugin}</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <version>${version.maven-pmd-plugin}</version>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${version.jacoco-maven-plugin}</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>${version.maven-javadoc-plugin}</version>
        <configuration>
          <show>public</show>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-report-plugin</artifactId>
        <version>${version.maven-surefire-report-plugin}</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-project-info-reports-plugin</artifactId>
        <version>${version.maven-project-info-reports-plugin}</version>
        <reportSets>
          <reportSet>
            <reports>
              <report>summary</report>
              <report>project-team</report>
              <report>license</report>
              <report>dependencies</report>
            </reports>
          </reportSet>
        </reportSets>
      </plugin>
    </plugins>
  </reporting>
</project>
